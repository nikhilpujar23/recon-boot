# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://localhost:5432/recon
DB_USER=recon
DB_PASSWORD=recon

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=recon

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Dummy key — passes the non-blank validation. Do not trigger an investigation
# until you replace this with a real key.
ANTHROPIC_API_KEY=sk-ant-dummy-no-llm-yet
MODEL_TRIAGE=claude-haiku-4-5
MODEL_INVEST=claude-sonnet-4-6

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_S=30
MOCK_LLM=true

# ── Rules ─────────────────────────────────────────────────────────────────────
RULES_TOLERANCE_PAISE=1

# ── PII  (generate 32 random bytes, base64-encode) ────────────────────────────
# openssl rand -base64 32
PAN_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PAN_AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── API ───────────────────────────────────────────────────────────────────────
API_BEARER_TOKEN=changeme

# ── SFTP ──────────────────────────────────────────────────────────────────────
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=recon
SFTP_PASSWORD=recon
SFTP_REMOTE_DIR=/config/home/recon/upload

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
