# Caddy reverse proxy — recon-agent
#
# Dev (HTTP only): set RECON_HOST=localhost in your shell and run docker compose up.
# Prod (HTTPS):    set RECON_HOST=your.domain.com — Caddy auto-provisions a cert via Let's Encrypt.
#
# The API service is Phase 5. Until then, all /api/* requests return 502.

{$RECON_HOST:localhost} {

    # ── API (Phase 5) ─────────────────────────────────────────────────────────
    handle /api/* {
        reverse_proxy api:8000 {
            header_up X-Request-ID {http.request.uuid}
            health_uri /healthz
            health_interval 10s
        }
    }

    # ── Prometheus metrics (internal — not exposed publicly in prod) ──────────
    handle /metrics {
        reverse_proxy prometheus:9090
    }

    # ── Grafana dashboards ────────────────────────────────────────────────────
    handle /grafana/* {
        uri strip_prefix /grafana
        reverse_proxy grafana:3000
    }

    # ── Catch-all: return 404 ─────────────────────────────────────────────────
    handle {
        respond "Not found" 404
    }

    # Access logs in JSON
    log {
        output stdout
        format json
    }
}
