# ── Required ──────────────────────────────────────────────────────────────────
# When running locally (no Docker): use localhost
# When running inside Docker Compose: host is the service name (postgres / kafka)
DATABASE_URL=postgresql://recon:recon@postgres:5432/recon
ANTHROPIC_API_KEY=sk-ant-...

# ── PII encryption keys ───────────────────────────────────────────────────────
# Generate with:
#   python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PAN_HMAC_KEY=
PAN_AES_KEY=

# ── API ───────────────────────────────────────────────────────────────────────
API_BEARER_TOKEN=changeme

# ── Kafka (Phase 2) ───────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_PREFIX=recon

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Set to your deployment environment name (development / staging / production)
ENVIRONMENT=development

# ── Feature flags ─────────────────────────────────────────────────────────────
DISABLE_AUTO_APPROVE=false
# Set MOCK_LLM=true to run without a real Anthropic API key (uses stub responses)
MOCK_LLM=false
